{
  "eslint.enable": true,
  "eslint.run": "onType",
  "eslint.autoFixOnSave": false,
  "eslint.codeAction.showDocumentation": {
    "enable": true
  },
  "suggest.completionItemKindLabels": {
    "class": "类",
    "color": "颜",
    "constant": "\uf8fe",
    "default": "默",
    "enum": "\uf435",
    "enumMember": "\uf02b",
    "event": "\ufacd",
    "field": "\uf93d",
    "file": "\uf723",
    "folder": "\uf115",
    "function": "函",
    "interface": "\uf417",
    "keyword": "\uf1de",
    "method": "\uf6a6",
    "module": "\uf40d",
    "operator": "\uf915",
    "property": "\ue624",
    "reference": "\ufa46",
    "snippet": "\ue60b",
    "struct": "\ufb44",
    "text": "\ue612",
    "typeParameter": "\uf728",
    "unit": "\uf475",
    "value": "值",
    "variable": "\ue71b"
  },
  "coc.preferences.formatOnSave": false,
  "coc.preferences.colorSupport": true,
  "javascript.format.enabled": true,
  "cSpell.userWords": [
    "ALIPAY",
    "Maatwebsite",
    "Niming",
    "PAYPAL",
    "REFUNED",
    "Srmklive",
    "Vuex",
    "aggs",
    "apiclient",
    "clsx",
    "endcomponent",
    "endphp",
    "endsection",
    "iife",
    "laravel",
    "mygroup",
    "phpls",
    "portfinder",
    "seckill",
    "skus",
    "struct",
    "swal",
    "tiktok",
    "vdebug",
    "vetur",
    "wechat",
    "xdebug"
  ],
  "cSpell.enabledLanguageIds": [
    "javascript",
    "javascriptreact",
    "markdown",
    "php",
    "plaintext",
    "typescript",
    "typescriptreact",
    "yml"
  ],
  "cSpell.enabled": true,
  "cSpell.ignorePaths": [
    "public",
    "node_modules", // this will ignore anything the node_modules directory
    "**/node_modules", // the same for this one
    "**/node_modules/**", // the same for this one
    "node_modules/**", // Doesn't currently work due to how the current working directory is determined.
    "vscode-extension", //
    ".git", // Ignore the .git directory
    "*.dll", // Ignore all .dll files.
    "**/*.dll" // Ignore all .dll files
  ],
  "emmet.includeLanguages": {
    "vue-html": "html",
    "javascript": "javascriptreact"
  },
  "prettier.enable": true,
  "tailwindCSS.emmetCompletions": true,
  "tailwindCSS.headwind.runOnSave": false,
  "json": {
    "enable": true,
    "validate": {
      "enable": true
    },
    "format": {
      "enable": false,
      "keepLines": true
    }
  }
}
